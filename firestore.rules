rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function validProfileCreate(data) {
      return data.keys().hasAll(['uid','email','displayName','avatarId','themeId','deckStyle','purchasedDecks','updatedAt','createdAt'])
        && data.keys().hasOnly(['uid','email','displayName','avatarId','themeId','deckStyle','purchasedDecks','updatedAt','createdAt'])
        && data.keys().size() == 9
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 80
        && data.avatarId is string && data.avatarId.size() <= 64
        && data.themeId is string && data.themeId.size() <= 64
        && data.deckStyle == 'deck_classic'
        && data.purchasedDecks is list && data.purchasedDecks.size() == 1
        && data.purchasedDecks[0] == 'deck_classic'
        && data.updatedAt is string && data.createdAt is string;
    }
    function validProfilePreferenceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarId','themeId','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.avatarId is string && request.resource.data.avatarId.size() <= 64
        && request.resource.data.themeId is string && request.resource.data.themeId.size() <= 64
        && request.resource.data.updatedAt is string;
    }
    function validTrackerSession(data, sessionId) {
      return data.userId == request.auth.uid
        && isValidId(sessionId) && data.id == sessionId
        && data.teamAName is string && data.teamAName.size() >= 1 && data.teamAName.size() <= 64
        && data.teamBName is string && data.teamBName.size() >= 1 && data.teamBName.size() <= 64
        && data.teamAScore is number && data.teamAScore >= -10000 && data.teamAScore <= 10000
        && data.teamBScore is number && data.teamBScore >= -10000 && data.teamBScore <= 10000
        && data.teamABags is number && data.teamABags >= 0 && data.teamABags <= 10
        && data.teamBBags is number && data.teamBBags >= 0 && data.teamBBags <= 10
        && data.winningScore is number && data.winningScore >= 100 && data.winningScore <= 5000
        && data.rounds is list && data.rounds.size() <= 100
        && data.updatedAt is string && data.createdAt is string;
    }
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      // Clients create identity/preferences only. Economic state is server-owned.
      allow create: if isOwner(userId) && isValidId(userId) && validProfileCreate(request.resource.data);
      // Clients may update non-economic profile preferences only.
      allow update: if isOwner(userId) && isValidId(userId) && validProfilePreferenceUpdate();
      allow delete: if false;
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId)
          && request.resource.data.keys().hasAll(['id','userId','teamAName','teamAScore','teamABags','teamBName','teamBScore','teamBBags','winningScore','rounds','updatedAt','createdAt'])
          && request.resource.data.keys().size() == 12
          && validTrackerSession(request.resource.data, sessionId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId)
          && validTrackerSession(request.resource.data, sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamAScore','teamABags','teamBScore','teamBBags','rounds','updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
